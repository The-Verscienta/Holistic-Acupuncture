{
  "name": "virtual-velocity",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/convert-logo-to-webp.js && node scripts/generate-condition-redirects.js && node scripts/generate-blog-redirect-pages.js && node scripts/generate-missing-redirects.js",
    "build": "astro build",
    "postbuild": "node scripts/build-search-index.js && node scripts/finalize-redirects.js",
    "check": "astro check",
    "lint": "astro check",
    "build:search": "astro build && npx pagefind --site dist/client --root-selector \"[data-pagefind-body]\"",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "export:media": "node scripts/export-media-to-kiln.js",
    "validate:structured-data": "node scripts/validate-structured-data.js",
    "cloudflare:images-ttl": "node scripts/set-cloudflare-images-browser-ttl.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.4.8",
    "@astrojs/sitemap": "^3.7.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "~7.4.12",
    "dotenv": "^16.4.7",
    "resend": "^6.9.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "pagefind": "1.4.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
