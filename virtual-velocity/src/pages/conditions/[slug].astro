---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { getAllConditions, getConditionBySlug, getAllTestimonials } from '../../lib/kilnQueries';
import { BOOK_PATH, CONTACT, SERVICE_AREAS, NEW_PATIENT_SPECIAL } from '../../lib/config';
import { conditionCategories } from '../../types/content';
export async function getStaticPaths() {
  const conditions = await getAllConditions();
  return Promise.all(
    conditions.map(async (listed) => ({
      params: { slug: listed.slug.current },
      props: { condition: (await getConditionBySlug(listed.slug.current)) ?? listed },
    }))
  );
}

const { condition } = Astro.props;

if (!condition) {
  return Astro.redirect('/404');
}

// Bing warns on <title> over 70 chars (Google truncates around 60). A CMS
// meta title is used verbatim; otherwise build the shortest local title that
// keeps "Milwaukee" without blowing the 60-char budget.
const TITLE_SUFFIX = ' | Milwaukee Acupuncture';
const withTreatment = `${condition.name} Treatment${TITLE_SUFFIX}`;
const withoutTreatment = `${condition.name}${TITLE_SUFFIX}`;
const metaTitle =
  condition.seo?.metaTitle ||
  (withTreatment.length <= 60
    ? withTreatment
    : withoutTreatment.length <= 60
      ? withoutTreatment
      : `${condition.name} Treatment`);
const metaDescription = condition.seo?.metaDescription || `${condition.description} Learn more about acupuncture treatment in Milwaukee, Wisconsin.`;
// The Kiln body carries both former rich-text sections, separated by an
// embedded "How Acupuncture Helps" heading block.
const contentHtml = condition.contentHtml || '';
const categoryLabel = conditionCategories[condition.category] || condition.category;

// Condition name for use mid-sentence: lowercase ordinary words but keep
// acronyms (IBS, GERD) and proper names (Bell's) as written.
const nameInline = condition.name
  .split(' ')
  .map((w) => (/^[A-Z]{2,}/.test(w) || /^[A-Z][a-z]*'s$/.test(w) ? w : w.toLowerCase()))
  .join(' ');

// Generated, condition-specific FAQ (used for both on-page UI and JSON-LD).
const conditionFaqs = [
  {
    question: `Can acupuncture help with ${nameInline} in Milwaukee?`,
    answer: `Many patients come to us for ${nameInline}. Our licensed acupuncturists in Glendale, WI look at your whole health picture to find the underlying cause, then build a plan around you. At your first visit we'll talk honestly about whether acupuncture is a good fit.`,
  },
  {
    question: `How many acupuncture sessions are needed for ${nameInline}?`,
    answer: condition.treatmentDuration
      ? `Most patients follow a course of ${condition.treatmentDuration}. We create a personalized plan at your first visit and adjust it based on your progress.`
      : `It varies by individual. Acute issues may improve in 3-6 sessions, while chronic conditions often need 8-12. We create a personalized plan at your first visit.`,
  },
  {
    question: `Is acupuncture for ${nameInline} covered by insurance in Wisconsin?`,
    answer: `Many Wisconsin insurance plans cover acupuncture, especially for pain-related conditions. We do not bill insurance directly, but we can provide a superbill for you to submit to your insurance for possible reimbursement. Check with your provider about your acupuncture benefits before you book.`,
  },
];

// One patient review for social proof next to the booking CTA. Prefer a review
// whose "condition treated" shares a key word with this condition (e.g. "Chronic
// Back Pain" ↔ "Back & Neck Pain"), then a featured review, then a fuller review
// picked by slug so different condition pages don't all show the same one.
const GENERIC_WORDS = new Set(['pain', 'issues', 'symptoms', 'support', 'disorders', 'chronic', 'and']);
const keyWords = (text: string) =>
  new Set(text.toLowerCase().split(/[^a-z']+/).filter((w) => w.length > 2 && !GENERIC_WORDS.has(w)));
const conditionWords = keyWords(condition.name);
const usable = (await getAllTestimonials()).filter((t) => t.quote);
const matching = usable.find((t) => [...keyWords(t.condition)].some((w) => conditionWords.has(w)));
const fuller = usable.filter((t) => t.quote.length >= 80);
const pool = fuller.length > 0 ? fuller : usable;
const slugHash = [...condition.slug.current].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 0);
// Never fall back to a review tagged with a *different* condition (a back-pain
// story on the anxiety page reads as a mismatch); use untagged reviews instead.
const untagged = pool.filter((t) => !t.condition);
const fallbackPool = untagged.length > 0 ? untagged : pool;
const testimonial =
  matching ??
  fallbackPool.find((t) => t.featured) ??
  fallbackPool[slugHash % Math.max(fallbackPool.length, 1)];

const conditionFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: conditionFaqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout title={metaTitle} titleIsFull description={metaDescription} breadcrumbs={[{name:'Home',url:'/'},{name:'Conditions We Treat',url:'/conditions'},{name:condition.name}]}>
  <script type="application/ld+json" set:html={JSON.stringify(conditionFaqSchema)} />
  <!-- Hero -->
  <section class="bg-gradient-to-br from-sage-50 to-warm-white py-12 md:py-16">
    <Container>
      <a href="/conditions" class="inline-flex items-center gap-2 text-sage-600 hover:text-sage-700 text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        All Conditions
      </a>
      <Badge variant="default" size="md" class="mb-4">{categoryLabel}</Badge>
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-charcoal mb-4">
        {condition.name}
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl">
        {condition.description}
      </p>
    </Container>
  </section>

  <!-- Main content -->
  <section class="py-12 md:py-16 bg-white">
    <Container>
      <div class="max-w-3xl">
        {condition.symptoms && condition.symptoms.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-heading font-bold text-charcoal mb-4">Common Symptoms</h2>
            <ul class="list-disc list-inside space-y-2 text-gray-700">
              {condition.symptoms.map((symptom) => (
                <li>{symptom}</li>
              ))}
            </ul>
          </div>
        )}

        {contentHtml && (
          <div class="prose-content mb-12" set:html={contentHtml} />
        )}

        <div class="mb-12">
          <h2 class="text-2xl font-heading font-bold text-charcoal mb-4">
            Why Milwaukee &amp; Glendale Patients Choose Acupuncture for {condition.name}
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Patients from across the Milwaukee area come to our Glendale clinic for {nameInline}.
            Our licensed acupuncturists combine acupuncture with East Asian Medicine to look for
            the underlying cause, not just the symptoms, and shape a plan around you.
          </p>
          <p class="text-gray-700 leading-relaxed">
            We welcome patients from {SERVICE_AREAS.filter((a) => a !== 'Milwaukee').join(', ')} and across greater Milwaukee.
            Conveniently located with free parking, our calm clinic makes it easy to fit care into
            your week. <a href="/contact" class="text-sage-600 hover:text-sage-700 underline">Contact us</a>
            or <a href="/services" class="text-sage-600 hover:text-sage-700 underline">view our pricing</a> to get started.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-2xl font-heading font-bold text-charcoal mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {conditionFaqs.map((faq) => (
              <Card variant="bordered" padding="none" class="bg-white overflow-hidden">
                <details class="group">
                  <summary class="flex items-center justify-between cursor-pointer p-5 hover:bg-sage-50 transition-colors list-none">
                    <h3 class="text-base md:text-lg font-heading font-semibold text-charcoal pr-4">{faq.question}</h3>
                    <svg class="w-5 h-5 text-sage-600 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </summary>
                  <div class="px-5 pb-5 pt-1"><p class="text-gray-700 leading-relaxed">{faq.answer}</p></div>
                </details>
              </Card>
            ))}
          </div>
        </div>

        {condition.treatmentDuration && (
          <Card variant="bordered" padding="lg" class="mb-12">
            <p class="text-gray-700">
              <strong>Typical treatment duration:</strong> {condition.treatmentDuration}
            </p>
          </Card>
        )}

        {condition.relatedConditions && condition.relatedConditions.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-heading font-bold text-charcoal mb-4">Related Conditions</h2>
            <div class="flex flex-wrap gap-2">
              {condition.relatedConditions.map((rel) => (
                <a
                  href={`/conditions/${rel.slug.current}`}
                  class="inline-flex items-center px-4 py-2 rounded-lg bg-sage-100 text-sage-800 hover:bg-sage-200 font-medium text-sm transition-colors"
                >
                  {rel.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-12 md:py-16 bg-sage-50">
    <Container class="text-center">
      <h2 class="text-2xl font-heading font-bold text-charcoal mb-4">
        Considering acupuncture for {nameInline}?
      </h2>
      <p class="text-gray-600 mb-6 max-w-xl mx-auto">
        Your first visit is an unhurried consultation plus your first treatment &mdash; ${NEW_PATIENT_SPECIAL.price} for new patients.
      </p>
      {testimonial && (
        <div class="max-w-2xl mx-auto mb-8 text-left">
          <TestimonialCard
            quote={testimonial.quote}
            author={testimonial.author}
            condition={testimonial.condition}
            rating={testimonial.rating}
          />
        </div>
      )}
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button variant="primary" size="lg" icon="calendar" href={BOOK_PATH}>
          Book Your ${NEW_PATIENT_SPECIAL.price} First Visit
        </Button>
        <Button variant="tertiary" size="lg" icon="phone" href={`tel:${CONTACT.phoneRaw}`}>
          Call {CONTACT.phone}
        </Button>
      </div>
      <p class="text-sm text-gray-600 mt-4">
        Have a question first? <a href="/contact" class="text-sage-700 underline underline-offset-2 hover:text-sage-900">Send us a message</a>.
      </p>
    </Container>
  </section>
</BaseLayout>

<style>
  .prose-content :global(p) {
    color: var(--color-gray-600);
    line-height: 1.625;
    margin-bottom: 1rem;
  }
  .prose-content :global(h2) {
    font-size: var(--font-size-2xl);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-charcoal);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-content :global(h3) {
    font-size: var(--font-size-xl);
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-charcoal);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
</style>
