---
import BlogPostPage from '../../components/BlogPostPage.astro';
import { getBlogPostBySlug, getRelatedBlogPosts } from '../../lib/kilnQueries';

// Rendered on demand so a post works the moment it is published in Kiln: the
// /blog index is SSR, so a prerendered post page would 404 from publish until
// the webhook-triggered rebuild finished. Search and sitemap still come from
// the prerendered shadow copy in src/pages/search-index/blog/[slug].astro.
export const prerender = false;

// Runtime env carries the Kiln base URL on Cloudflare
const kilnUrl = (Astro.locals as any).runtime?.env?.KILN_API_URL;
const slug = Astro.params.slug!;

const post = await getBlogPostBySlug(slug, kilnUrl);
if (!post) {
  // Empty 404 response makes Astro serve the prerendered 404 page
  return new Response(null, { status: 404 });
}
const relatedPosts = await getRelatedBlogPosts(slug, post.category, 3, kilnUrl);
---

<BlogPostPage post={post} relatedPosts={relatedPosts} />
