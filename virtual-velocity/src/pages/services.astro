---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import CloudflareImage from '../components/CloudflareImage.astro';
import { BOOK_PATH, CONTACT, NEW_PATIENT_SPECIAL, REVIEW_STATS, GOOGLE_REVIEWS_URL } from '../lib/config';
import { getRandomTestimonials } from '../lib/kilnQueries';
import { NEW_PATIENT_FAQS } from '../data/newPatientFaqs';
import TestimonialCard from '../components/TestimonialCard.astro';
import FirstVisitSteps from '../components/FirstVisitSteps.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTASection from '../components/CTASection.astro';
import FeatureCard from '../components/FeatureCard.astro';
import NewPatientSpecial from '../components/NewPatientSpecial.astro';

const services = [
  {
    name: 'Initial Consultation & Treatment',
    description: 'Comprehensive health assessment, diagnosis, and your first acupuncture treatment. Includes detailed health history review and personalized treatment plan.',
    duration: '90-120 minutes',
    price: 350,
    popular: true,
    badgeLabel: 'Most Popular',
    bookOnline: true,
    includes: [
      'Complete health history review',
      'Traditional Chinese medicine diagnosis',
      {
        label: 'Personalized treatment plan',
        info: 'Your acupuncturist will suggest a series of treatments to see how your body responds to acupuncture.'
      },
      'First acupuncture session',
      'Herbal recommendations if needed'
    ]
  },
  {
    name: 'Acupuncture Session',
    description: 'Standard acupuncture treatment session for returning patients. Includes brief check-in and adjustment of treatment as needed.',
    duration: '45 minutes',
    price: 90,
    popular: true,
    badgeLabel: 'Popular',
    includes: [
      'Progress evaluation',
      'Acupuncture treatment',
      'Treatment plan adjustment',
      'Self-care recommendations'
    ]
  },
  {
    name: 'Re-Examination',
    description: 'For returning patients, and patients that have gone through a series of treatments. We perform a series of evaluations to see that we are making progress. This includes: range of motion, pulse check, tongue diagnosis, and comprehensive evaluation of the underlying issues.',
    duration: '30 minutes',
    price: 100,
    popular: false,
    includes: [
      'Extended health consultation',
      'Comprehensive acupuncture assessment',
      'Range of Motion',
      'Adjustments based on the results'
    ]
  },
  {
    name: 'Herbal Consultation',
    description: 'Personalized Chinese herbal medicine consultation. Custom formula created based on your specific health needs.',
    duration: '15 minutes',
    price: 60,
    popular: false,
    includes: [
      'Herbal medicine assessment',
      'Custom formula recommendation',
      'Dosage instructions',
      'Dietary guidance'
    ],
    note: 'Herbs purchased separately'
  },
  {
    name: 'Rapid Release Treatment',
    description: 'Using RRT style treatment to help release muscle tension and aching.',
    duration: '5 minutes',
    price: 35,
    popular: false,
    includes: [
      'Rapid release treatment',
      'One area of the body per session',
      'Quick consultation'
    ],
    note: 'Not for use while pregnant'
  },
  {
    name: 'Cupping Therapy',
    description: 'Traditional cupping therapy to relieve muscle tension, improve circulation, and promote healing. Can be standalone or added to acupuncture.',
    duration: '30 minutes',
    price: 45,
    popular: false,
    includes: [
      'Assessment of treatment areas',
      'Cupping application',
      'Post-treatment care instructions'
    ],
    note: 'Add-on to acupuncture: $25'
  }
];

const packages = [
  {
    name: 'New Patient Special',
    description: 'Perfect for first-time patients wanting to experience acupuncture.',
    sessions: 'Initial visit',
    price: 59,
    originalPrice: 350,
    savings: 291,
    highlight: true,
    features: [
      'Full initial consultation',
      'First acupuncture treatment',
      {
        label: 'Personalized treatment plan',
        info: 'Your acupuncturist will suggest a series of treatments to see how your body responds to acupuncture.'
      },
      'Limited time offer'
    ],
    limitations: []
  },
  {
    name: '5-Session Package',
    description: 'Ideal for acute conditions or those starting their healing journey.',
    sessions: '5 follow-up sessions',
    price: 410,
    originalPrice: 450,
    savings: 40,
    highlight: false,
    features: [
      '5 acupuncture sessions ($82 each)',
      'Save $8 per session',
      'Flexible scheduling',
      'Valid for 3 months'
    ],
    limitations: [
      'Re-exams are not included, so progress is not formally charted',
      'Point prescription stays the same for every session'
    ]
  },
  {
    name: '10-Session Package',
    description: 'Best value for chronic conditions requiring ongoing treatment. Best for those whose schedule is always changing.',
    sessions: '10 follow-up sessions',
    price: 800,
    originalPrice: 900,
    savings: 100,
    highlight: false,
    features: [
      '10 acupuncture sessions ($80 each)',
      'Save $10 per session',
      'Priority scheduling',
      'Valid for 6 months'
    ],
    limitations: [
      'Re-exams are not included, so progress is not formally charted',
      'Point prescription stays the same for every session'
    ]
  }
];

const testimonials = await getRandomTestimonials(3);

// "Not sure where to start?" — routes each kind of visitor to the right option.
const startGuide = [
  {
    who: "I'm new to the clinic",
    pick: `New Patient Special — $${NEW_PATIENT_SPECIAL.price}`,
    why: 'Full consultation plus your first treatment, at a reduced first-visit price.',
    href: '#new-patient-special',
    icon: 'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z',
  },
  {
    who: "I've been here before",
    pick: `Acupuncture Session — $${services.find(s => s.name === 'Acupuncture Session')?.price}`,
    why: 'A standard follow-up session with a quick check-in on your progress.',
    href: '#individual-services',
    icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  },
  {
    who: 'I have an ongoing condition',
    pick: 'A 5- or 10-session package',
    why: 'Regular treatment for chronic issues, at a lower price per session.',
    href: '#packages',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
];
---

<BaseLayout
  title="Acupuncture Services & Pricing in Milwaukee"
  description="Acupuncture services & transparent pricing in Milwaukee & Glendale, WI — consultations, treatment packages, cupping & herbal medicine. See costs & book today."
  breadcrumbs={[{name:'Home',url:'/'},{name:'Services & Pricing'}]}
>
  <!-- Hero Section -->
  <PageHero
    title="Services & Pricing"
    description="Transparent pricing for quality acupuncture care. We believe in providing exceptional value and personalized treatment for every patient."
  />

  <!-- Treatment Image Banner -->
  <section class="py-12 md:py-16 bg-white">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-7xl mx-auto">
        <div class="aspect-[3/2] rounded-2xl overflow-hidden">
          <CloudflareImage
            imageId="wp-15146"
            alt="Acupuncture needles during treatment"
            width={600}
            height={400}
            fit="cover"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="aspect-[3/2] rounded-2xl overflow-hidden">
          <CloudflareImage
            imageId="wp-14454"
            alt="Chinese herbal medicine bottles"
            width={600}
            height={400}
            fit="cover"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="aspect-[3/2] rounded-2xl overflow-hidden">
          <CloudflareImage
            imageId="wp-14802"
            alt="Shoulder acupuncture treatment"
            width={600}
            height={400}
            fit="cover"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Not sure where to start? -->
  <section class="py-12 md:py-16 bg-sage-50">
    <Container>
      <SectionHeader title="Not Sure Where to Start?" subtitle="Pick the option that sounds most like you." class="!mb-8 md:!mb-10" />
      <div class="grid md:grid-cols-3 gap-4 md:gap-6 max-w-5xl mx-auto">
        {startGuide.map(option => (
          <a
            href={option.href}
            class="group flex md:flex-col gap-4 bg-white rounded-2xl border border-sage-200 p-5 md:p-6 hover:border-sage-500 hover:shadow-md transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600"
          >
            <span class="w-11 h-11 rounded-full bg-sage-100 text-sage-700 flex items-center justify-center flex-shrink-0" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={option.icon}></path>
              </svg>
            </span>
            <span class="flex flex-col">
              <span class="text-sm text-gray-500 mb-1">{option.who}</span>
              <span class="font-heading font-semibold text-charcoal group-hover:text-sage-700 mb-1">{option.pick}</span>
              <span class="text-sm text-gray-600 mb-2">{option.why}</span>
              <span class="text-sm font-medium text-sage-700 inline-flex items-center gap-1">
                See details
                <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
              </span>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <div id="new-patient-special" class="scroll-mt-24">
    <NewPatientSpecial />
  </div>

  <!-- Your first visit -->
  <section class="py-12 md:py-16 bg-sage-50">
    <Container>
      <SectionHeader title="Your First Visit in 3 Steps" subtitle="Here's what happens when you book your first appointment." class="!mb-8 md:!mb-12" />
      <div class="max-w-5xl mx-auto">
        <FirstVisitSteps />
      </div>
    </Container>
  </section>

  <!-- Individual Services -->
  <section id="individual-services" class="py-16 md:py-20 lg:py-24 bg-white scroll-mt-24">
    <Container>
      <SectionHeader title="Individual Services" subtitle="Choose the service that best fits your needs. All treatments are personalized to your unique health concerns." />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(service => (
          <Card variant="bordered" padding="none" class="flex flex-col h-full">
            <div class="p-6 flex-1 flex flex-col">
              {service.badgeLabel && (
                <div class="mb-3">
                  <Badge variant="success" size="md">{service.badgeLabel}</Badge>
                </div>
              )}
              <h3 class="text-xl font-heading font-semibold text-charcoal mb-2">
                {service.name}
              </h3>
              <p class="text-gray-600 text-sm mb-4 flex-1">
                {service.description}
              </p>

              <div class="flex items-center gap-3 mb-4 text-sm text-gray-500">
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  {service.duration}
                </span>
              </div>

              <ul class="space-y-2 mb-4">
                {service.includes.map((item: string | { label: string; info: string }) => (
                  <li class="flex items-start gap-2 text-sm text-gray-600">
                    <svg class="w-4 h-4 text-sage-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {typeof item === 'string' ? item : (
                      <details class="group flex-1">
                        <summary class="inline-flex items-center gap-1 cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600">
                          {item.label}
                          <svg class="w-4 h-4 text-sage-600 group-open:text-sage-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                          <span class="sr-only">(more info)</span>
                        </summary>
                        <p class="mt-2 rounded-lg bg-sage-50 border border-sage-100 px-3 py-2 text-xs text-gray-700">
                          {item.info}
                        </p>
                      </details>
                    )}
                  </li>
                ))}
              </ul>

              {service.note && (
                <p class="text-xs text-gray-500 italic mb-4">* {service.note}</p>
              )}

              <div class="mt-auto pt-4 border-t border-gray-200">
                <div class="flex items-center justify-between">
                  <div class="text-2xl font-heading font-bold text-sage-700">
                    ${service.price}
                  </div>
                  {service.bookOnline ? (
                    <a
                      href={BOOK_PATH}
                      class="text-sage-600 hover:text-sage-700 font-medium text-sm flex items-center gap-1"
                    >
                      Book Now
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                      </svg>
                    </a>
                  ) : (
                    <a
                      href={`tel:${CONTACT.phoneRaw}`}
                      class="text-sage-600 hover:text-sage-700 font-medium text-sm flex items-center gap-1"
                      aria-label={`Call ${CONTACT.phone} to schedule ${service.name}`}
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                      </svg>
                      Call to schedule
                    </a>
                  )}
                </div>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <!-- Package Deals -->
  <section id="packages" class="py-16 md:py-20 lg:py-24 bg-sage-50 scroll-mt-24">
    <Container>
      <SectionHeader title="Package Deals" subtitle="Save money with our treatment packages. Ideal for ongoing care and chronic conditions." />

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {packages.map(pkg => (
          <Card
            variant={pkg.highlight ? "elevated" : "bordered"}
            padding="none"
            class={`flex flex-col h-full ${pkg.highlight ? 'ring-2 ring-tcm-red' : ''}`}
          >
            <div class={`p-6 text-center ${pkg.highlight ? 'bg-tcm-red/5' : ''}`}>
              {pkg.highlight && (
                <div class="mb-3">
                  <Badge variant="warning" size="lg">Best Value</Badge>
                </div>
              )}
              <h3 class="text-xl font-heading font-semibold text-charcoal mb-1">
                {pkg.name}
              </h3>
              <p class="text-sm text-gray-500 mb-4">{pkg.sessions}</p>

              <div class="mb-2">
                <span class="text-4xl font-heading font-bold text-sage-700">${pkg.price}</span>
                {pkg.originalPrice > pkg.price && (
                  <span class="text-lg text-gray-400 line-through ml-2">${pkg.originalPrice}</span>
                )}
              </div>

              {pkg.savings > 0 && (
                <Badge variant="success" size="sm">Save ${pkg.savings}</Badge>
              )}
            </div>

            <div class="p-6 flex-1 flex flex-col border-t border-gray-200">
              <p class="text-gray-600 text-sm mb-4">
                {pkg.description}
              </p>

              <ul class="space-y-3 mb-6 flex-1">
                {pkg.features.map((feature: string | { label: string; info: string }) => (
                  <li class={`flex gap-2 text-sm text-gray-700 ${typeof feature === 'string' ? 'items-center' : 'items-start'}`}>
                    <svg class="w-5 h-5 text-sage-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {typeof feature === 'string' ? (
                      feature.startsWith('Valid for') ? <strong>{feature}</strong> : feature
                    ) : (
                      <details class="group flex-1">
                        <summary class="inline-flex items-center gap-1 cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600">
                          {feature.label}
                          <svg class="w-4 h-4 text-sage-600 group-open:text-sage-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                          <span class="sr-only">(more info)</span>
                        </summary>
                        <p class="mt-2 rounded-lg bg-sage-50 border border-sage-100 px-3 py-2 text-xs text-gray-700 text-left">
                          {feature.info}
                        </p>
                      </details>
                    )}
                  </li>
                ))}
              </ul>

              {pkg.limitations.length > 0 && (
                <div class="mb-6 pt-4 border-t border-gray-200">
                  <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-3">
                    Good to know
                  </p>
                  <ul class="space-y-3">
                    {pkg.limitations.map(limitation => (
                      <li class="flex items-start gap-2 text-sm text-gray-600">
                        <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        <span>{limitation}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <Button
                variant={pkg.highlight ? "primary" : "secondary"}
                size="md"
                href={BOOK_PATH}
                class="w-full justify-center"
              >
                Get Started
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <!-- Reviews -->
  {testimonials.length > 0 && (
    <section class="py-16 md:py-20 bg-white">
      <Container>
        <SectionHeader title="What Our Patients Say" subtitle={`Rated ${REVIEW_STATS.rating} stars by ${REVIEW_STATS.count} patients on Google.`} />
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {testimonials.map(testimonial => (
            <TestimonialCard
              quote={testimonial.quote}
              author={testimonial.author}
              condition={testimonial.condition}
              rating={testimonial.rating}
            />
          ))}
        </div>
        <div class="text-center mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="tertiary" size="lg" icon="arrow-right" iconPosition="right" href="/reviews">
            See all patient reviews
          </Button>
          <Button variant="tertiary" size="lg" icon="external" iconPosition="right" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener noreferrer">
            Read all {REVIEW_STATS.count} reviews on Google
          </Button>
        </div>
      </Container>
    </section>
  )}

  <!-- Common Questions -->
  <section class="py-16 md:py-20 bg-sage-50">
    <Container>
      <SectionHeader title="Common Questions" subtitle="Quick answers to what new patients ask before booking." />
      <div class="max-w-3xl mx-auto space-y-4">
        {NEW_PATIENT_FAQS.map(faq => (
          <Card variant="bordered" padding="none" class="bg-white overflow-hidden">
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer p-5 md:p-6 hover:bg-sage-50 transition-colors list-none [&::-webkit-details-marker]:hidden">
                <h3 class="text-base md:text-lg font-heading font-semibold text-charcoal pr-4">{faq.question}</h3>
                <svg class="w-6 h-6 text-sage-600 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-5 md:px-6 pb-6 pt-1">
                <p class="text-gray-700 leading-relaxed">{faq.answer}</p>
              </div>
            </details>
          </Card>
        ))}
      </div>
      <div class="text-center mt-10">
        <Button variant="tertiary" size="lg" icon="arrow-right" iconPosition="right" href="/faq">
          See all FAQs
        </Button>
      </div>
    </Container>
  </section>

  <!-- Discount Programs -->
  <section class="py-12 md:py-16 bg-white">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest text-sage-600 mb-4">Discount Programs</span>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-charcoal mb-4">
          We Believe Care Should Be Accessible
        </h2>
        <p class="text-gray-600 mb-2">
          We offer a referral discount for patients who refer friends or family to our practice.
        </p>
        <p class="text-gray-600 mb-6">
          Hardship and sliding scale pricing is available for those who need it.
        </p>
        <a href="/contact" class="text-sage-700 font-medium underline underline-offset-4 hover:text-sage-900 transition-colors">
          Contact us to learn more about any of these programs
        </a>
      </div>
    </Container>
  </section>

  <!-- Insurance & Payment -->
  <section class="py-16 md:py-20 bg-white">
    <Container>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-charcoal mb-4">
            Insurance & Payment
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <FeatureCard
            layout="horizontal"
            cardVariant="bordered"
            title="Insurance Coverage"
            description="Many insurance plans now cover acupuncture. We provide detailed receipts (superbills) for you to submit to your insurance for reimbursement. Contact your insurance provider to check your acupuncture benefits before your visit."
            icon="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          />
          <FeatureCard
            layout="horizontal"
            cardVariant="bordered"
            title="Payment Options"
            description="We accept cash, all major credit cards, HSA/FSA cards, and Apple Pay/Google Pay for your convenience. Payment is due at the time of service. Package payments can be split upon request."
            icon="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA Section -->
  <CTASection
    heading="Ready to Start Your Healing Journey?"
    description="Book your appointment today and take the first step towards better health."
    primaryButton={{ label: 'Book Appointment', href: BOOK_PATH }}
